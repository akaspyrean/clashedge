{
  "$comment": "Clear Edge v2 design tokens. Source of truth: run `npm run tokens` in apps/windows to regenerate tokens.css and Tokens.kt. Keys omit the --ce- prefix.",
  "global": {
    "font-sans": "\"Segoe UI Variable Text\", \"Segoe UI\", \"Microsoft YaHei UI\", \"Microsoft YaHei\", -apple-system, \"PingFang SC\", \"Noto Sans CJK SC\", sans-serif",
    "font-mono": "\"JetBrains Mono\", \"Cascadia Code\", Consolas, monospace",

    "type-display": "700 40px/48px var(--ce-font-sans)",
    "type-title-1": "600 28px/36px var(--ce-font-sans)",
    "type-title-2": "600 20px/28px var(--ce-font-sans)",
    "type-title-3": "600 16px/24px var(--ce-font-sans)",
    "type-body": "400 14px/22px var(--ce-font-sans)",
    "type-body-strong": "500 14px/22px var(--ce-font-sans)",
    "type-callout": "400 13px/20px var(--ce-font-sans)",
    "type-caption": "500 12px/16px var(--ce-font-sans)",
    "type-mono": "400 13px/20px var(--ce-font-mono)",

    "radius-xs": "6px",
    "radius-sm": "8px",
    "radius-md": "12px",
    "radius-lg": "16px",
    "radius-xl": "20px",
    "radius-full": "999px",

    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "12px",
    "space-5": "16px",
    "space-6": "16px",
    "space-8": "32px",
    "space-10": "40px",
    "space-12": "48px",
    "space-16": "64px",

    "ease-standard": "cubic-bezier(0.2, 0, 0, 1)",
    "ease-enter": "cubic-bezier(0.05, 0.7, 0.1, 1)",
    "ease-exit": "cubic-bezier(0.3, 0, 0.8, 0.15)",
    "ease-spring": "cubic-bezier(0.34, 1.36, 0.64, 1)",
    "dur-instant": "80ms",
    "dur-fast": "140ms",
    "dur-base": "220ms",
    "dur-slow": "320ms",

    "control-h": "32px",
    "control-h-sm": "28px",
    "control-h-lg": "40px",
    "row-h": "40px",
    "icon": "20px",
    "icon-stroke": "1.75",
    "sidebar-w": "184px",
    "sidebar-w-collapsed": "64px"
  },
