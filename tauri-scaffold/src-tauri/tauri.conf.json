{
  "$schema": "https://schema.tauri.app/config/2",
  // 瀹夊叏璇存槑锛氬墠绔笉鐩磋繛浠讳綍澶栭儴 HTTP/WebSocket 鈥斺€?璁㈤槄 / geodata 鎷夊彇鍧囩敱鍚庣
  // reqwest 瀹屾垚锛屾棩蹇楄蛋 Tauri 浜嬩欢閫氶亾锛屽墠绔粎閫氳繃 invoke 璋冨悗绔懡浠ゃ€?
  // 鏁?CSP 鐨?connect-src 浠呬繚鐣?'self'锛堝悓婧?invoke / 浜嬩欢锛夛紝骞舵樉寮忓叧闂?
  // object / frame 娉ㄥ叆闈€俿tyle-src 淇濈暀 'unsafe-inline' 鍥?Element Plus 闇€瑕併€?
  "productName": "ClashEdge",
  "version": "1.0.1",
  "identifier": "com.clashedge.portable",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    // 鍓嶇鍏ㄩ儴閫氳繃鏄惧紡 import 璋冨懡浠わ紝鏃犻渶娉ㄥ叆鍏ㄥ眬 __TAURI__銆?
    // 涓荤獥鍙ｄ笉鍦ㄩ厤缃腑澹版槑锛歍auri 2 鐨?on_navigation 瀵艰埅閿佸畾浠呭湪
    // WebviewWindowBuilder 涓婂彲鐢紙閰嶇疆寮忕獥鍙ｆ棤娉曟寕鎺ワ級锛屾晠鍦?main.rs setup
    // 涓€氳繃 WebviewWindowBuilder 鍒涘缓锛岀獥鍙ｅ睘鎬т笌鏃ч厤缃繚鎸佷竴鑷淬€?
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/cat-32x32.png",
      "icons/cat-128x128.png",
      "icons/cat-256x256.png",
      "icons/cat.icns",
      "icons/cat.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}