<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Subscription / geodata fetching + manifest download. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground service + notification for the long-running proxy core. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- NOTE: BIND_VPN_SERVICE is NOT declared here on purpose - it is a
         signature/privileged permission and lint errors on <uses-permission>;
         the VpnService binding right is granted by declaring
         android:permission="android.permission.BIND_VPN_SERVICE" on
         .vpn.ClashVpnService below (see https://developer.android.com/guide/topics/connectivity/vpn). -->

    <application
        android:name=".ClashEdgeApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClashEdge">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ClashEdge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ProxyForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".vpn.ClashVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
